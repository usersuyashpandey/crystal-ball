# Copy this file to .env.local and fill in ONE key below.
# With none set, the app runs entirely on the offline mock provider —
# see README.md "Running without an API key".
#
# Automatic order: Anthropic -> OpenAI -> Gemini -> Groq -> offline mock.
# LLM_PROVIDER forces one of: anthropic | openai | gemini | groq | mock
# LLM_PROVIDER=groq

# Claude (the brief's primary option).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# GPT-4o (the brief's alternative).
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Google Gemini — free tier, no card needed. Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Groq — free tier, no card needed, fast. Key from https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
