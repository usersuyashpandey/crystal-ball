# Copy this file to .env.local and fill in ONE of the two keys below.
# With neither set, the app runs entirely on the offline mock provider —
# see README.md "Running without an API key".

# Preferred provider (lib/llm/index.ts checks Anthropic first, then OpenAI).
ANTHROPIC_API_KEY=
# Override the model id if your account doesn't have access to the default.
# ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
